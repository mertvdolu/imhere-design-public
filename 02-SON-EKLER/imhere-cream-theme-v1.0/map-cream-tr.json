{
  "version": 8,
  "name": "IM HERE — Cream / TR",
  "metadata": {
    "imhere:version": "1.0",
    "imhere:scope": "Founder selected cream basemap visual direction. Existing application owns band geometry and data.",
    "imhere:attribution": "© OpenStreetMap contributors · OpenFreeMap",
    "imhere:labelInsertBefore": "road-labels"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">© OpenStreetMap contributors</a> · <a href=\"https://openfreemap.org\">OpenFreeMap</a> · <a href=\"https://openmaptiles.org\">© OpenMapTiles</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F3F0E8"
      }
    },
    {
      "id": "vegetation",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#E4E5DB"
      },
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "grass",
          "scrub"
        ],
        true,
        false
      ]
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#E4E5DB"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#D6DEDD"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#C4CFCD",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          16,
          2
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#E4DED2",
        "fill-opacity": 0.7
      },
      "minzoom": 13
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#D0C7B8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.35,
          13,
          1,
          17,
          4
        ]
      },
      "minzoom": 8,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "track",
          "path"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#B3A99A",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          12,
          1.5,
          17,
          6
        ]
      },
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "paint": {
        "text-color": "#58594F",
        "text-halo-color": "#F3F0E8",
        "text-halo-width": 1.5
      },
      "minzoom": 14,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:tr"
          ],
          [
            "get",
            "name_tr"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-allow-overlap": false,
        "text-padding": 5,
        "symbol-placement": "line"
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#58594F",
        "text-halo-color": "#F3F0E8",
        "text-halo-width": 1.5
      },
      "minzoom": 3,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:tr"
          ],
          [
            "get",
            "name_tr"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-allow-overlap": false,
        "text-padding": 5
      }
    }
  ]
}
